# Healthcare.gov Marketplace API key
# Request a free key at: https://developer.cms.gov/marketplace-api/key-request.html
# For testing, CMS publishes a rate-limited key: d687412e7b53146b2631dc01974ad0a4
CMS_API_KEY=

# Demo / end-to-end mode.
# When set to 1, the expensive AI/KVR workflow is replaced by a deterministic
# fixture derived from the intake answers. Everything else — intake, validation,
# session state, SSE progress, report assembly, the SAWS 2 PLUS application
# flow, and PDF draft generation — runs the real production code path.
# Never set this in a production deployment.
E2E_MODE=

# Milliseconds each simulated phase runs in demo mode (default 700, max 10000).
# Set to 0 for an instant transition to the report.
E2E_PHASE_DELAY_MS=
